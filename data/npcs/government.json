    {
      "id": "bailiff-crowe",
      "name": "Bailiff Crowe",
      "species": "Human",
      "gender": "Male",
      "age": 48,
      "occupation": "Bailiff",
      "category": "government",
      "tags": [
        "bailiff",
        "fines",
        "grim"
      ],
      "description": "Familiar face at the magistrate's outer office; useful, stubborn, and hard to surprise.",
      "biography": "Crowe did not plan to become the neighborhood's go-to bailiff, yet the magistrate's outer office made the choice stick. Now 48, the Human measures success in quiet evenings and unpaid favors returned. He recites fine schedules like scripture, and keeps the baton he has never raised and always shows the way a confessor keeps secrets. Works with Judge Sava; pressured by alleys. Hope pulls one way—enforce law without starring in Kitty's rumors—while caution pulls the other because of becoming Marrow's public face. Was offered a bribe to 'misplace' Rook's holding paperwork.",
      "personality": "Proud of competence more than praise; recites fine schedules like scripture.",
      "motivation": "Protect his livelihood long enough to enforce law without starring in Kitty's rumors.",
      "secret": "Has not told allies the truth: Was offered a bribe to 'misplace' Rook's holding paperwork.",
      "rumor": "Someone paid Crowe to forget a name connected to recent trouble near the magistrate's outer office.",
      "voice": "Measured human cadence; concrete nouns before adjectives.",
      "appearance": "Work-worn human garb; the baton he has never raised and always shows always nearby.",
      "portrait": "modules/townforge/assets/portraits/bailiff-crowe.webp",
      "token": "modules/townforge/assets/tokens/bailiff-crowe.webp",
