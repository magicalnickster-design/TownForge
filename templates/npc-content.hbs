<aside class="townforge-library">
  <div class="townforge-library-toolbar">
    <label class="townforge-search">
      <span class="townforge-sr-only">Search NPCs</span>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="search"
        value="{{query}}"
        placeholder="Search NPCs..."
        data-townforge-search
        autocomplete="off"
      />
    </label>
  </div>

  <div class="townforge-category-row" role="toolbar" aria-label="NPC categories">
    {{#each primaryCategories}}
    <button
      type="button"
      class="townforge-cat-tab{{#if active}} is-active{{/if}}"
      data-action="setCategory"
      data-category="{{id}}"
    >{{label}}</button>
    {{/each}}

    <div class="townforge-more{{#if moreOpen}} is-open{{/if}}{{#if moreActive}} has-active{{/if}}">
      <button type="button" class="townforge-cat-tab townforge-more-toggle" data-action="toggleMore">
        More <i class="fa-solid fa-caret-down" aria-hidden="true"></i>
      </button>
      {{#if moreOpen}}
      <div class="townforge-more-menu">
        {{#each moreCategories}}
        <button
          type="button"
          class="townforge-more-item{{#if active}} is-active{{/if}}"
          data-action="setCategory"
          data-category="{{id}}"
        >{{label}}</button>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>

  <div class="townforge-library-meta">
    <span>{{resultCount}} NPCs</span>
    <div class="townforge-library-meta-actions">
      <div class="townforge-art-toggle" role="group" aria-label="Preview art">
        <button
          type="button"
          class="townforge-art-btn{{#unless showTokenArt}} is-active{{/unless}}"
          data-action="setArtPreview"
          data-mode="portrait"
        >Portrait</button>
        <button
          type="button"
          class="townforge-art-btn{{#if showTokenArt}} is-active{{/if}}"
          data-action="setArtPreview"
          data-mode="token"
        >Token</button>
      </div>
      <label class="townforge-sort">
      <span>Sort:</span>
      <select data-townforge-sort>
        <option value="name-asc"{{#if sortAsc}} selected{{/if}}>Name (A-Z)</option>
        <option value="name-desc"{{#if sortDesc}} selected{{/if}}>Name (Z-A)</option>
        <option value="recent"{{#if sortRecent}} selected{{/if}}>Recently Used</option>
        <option value="occupation"{{#if sortOccupation}} selected{{/if}}>Occupation</option>
        <option value="category"{{#if sortCategory}} selected{{/if}}>Category</option>
      </select>
    </label>
    </div>
  </div>

  <div class="townforge-library-scroll">
    {{#if npcs.length}}
    <div class="townforge-card-grid" role="list">
      {{#each npcs}}
      <button
        type="button"
        class="townforge-card{{#if selected}} is-selected{{/if}}{{#if favorite}} is-favorite{{/if}}"
        data-action="selectNpc"
        data-npc-id="{{id}}"
        role="listitem"
        style="--tf-cat: {{categoryColor}}"
      >
        <div class="townforge-card-media{{#if @root.showTokenArt}} is-token{{/if}}">
          <img
            src="{{previewImage}}"
            alt=""
            loading="lazy"
            data-townforge-img
            data-fallback="{{previewFallback}}"
          />
          {{#if favorite}}
          <span class="townforge-card-favorite" title="Favorite" aria-hidden="true">
            <i class="fa-solid fa-star"></i>
          </span>
          {{/if}}
        </div>
        <div class="townforge-card-body">
          <h2 class="townforge-card-name">{{name}}</h2>
          <p class="townforge-card-meta">{{metaLine}}</p>
          <span class="townforge-pill">{{categoryLabel}}</span>
        </div>
      </button>
      {{/each}}
    </div>
    {{else}}
    <div class="townforge-empty">
      {{#if emptyState}}
      <h3>{{emptyState.title}}</h3>
      <p>{{emptyState.body}}</p>
      {{else}}
      <p>No NPCs match your search.</p>
      {{/if}}
    </div>
    {{/if}}
  </div>
</aside>
