<section class="townforge-merchant-shell townforge-trade{{#if isGM}} is-gm-preview{{/if}}">
  <header class="townforge-merchant-hero">
    <img class="townforge-merchant-portrait" src="{{merchantImg}}" alt="" width="88" height="88" />
    <div class="townforge-merchant-hero-copy">
      <h2>{{merchantName}}</h2>
      <p class="townforge-merchant-shopname">{{shopName}}</p>
      <p class="townforge-merchant-type">{{shopTypeLabel}}</p>
      {{#if merchantGreeting}}
      <p class="townforge-merchant-greeting">{{merchantGreeting}}</p>
      {{/if}}
    </div>
    <div class="townforge-trade-buyer">
      {{#if isGM}}
      <p class="townforge-muted">Preview only. Players trade with their own characters.</p>
      {{else}}
      {{#if buyers.length}}
      <label class="townforge-buyer">
        <span>Trading as</span>
        <select data-townforge-buyer>
          {{#unless hasBuyer}}
          <option value="">Select character…</option>
          {{/unless}}
          {{#each buyers}}
          <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
      <div class="townforge-wallet-card">
        <div class="townforge-wallet-primary">
          <span>Purse</span>
          <strong>{{walletPrimary}}</strong>
        </div>
        <div class="townforge-wallet-denoms">
          {{#each walletCoins}}
          <span class="townforge-wallet-coin{{#if empty}} is-empty{{/if}}"><em>{{label}}</em>{{count}}</span>
          {{/each}}
        </div>
      </div>
      {{#if noCharacters}}
      <p class="townforge-warn">No owned character available.</p>
      {{else if needsBuyerChoice}}
      <p class="townforge-warn">Choose which character is trading.</p>
      {{/if}}
      {{/if}}
    </div>
    {{#if isGM}}
    <div class="townforge-merchant-gm-actions">
      <button type="button" class="townforge-btn townforge-btn-secondary" data-action="configureShop">
        <i class="fa-solid fa-gears"></i>
        <span>Configure</span>
      </button>
    </div>
    {{/if}}
  </header>

  <div class="townforge-trade-grid">
    <section class="townforge-trade-pane">
      <header class="townforge-trade-pane-header">
        <div class="townforge-trade-pane-title">
          <h3>Your Items</h3>
          <span class="townforge-pane-gold">{{walletPrimary}}</span>
        </div>
        <label class="townforge-search">
          <span class="townforge-sr-only">Search your items</span>
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" value="{{playerQuery}}" placeholder="Search…" data-townforge-player-search autocomplete="off" />
        </label>
      </header>
      <div class="townforge-trade-list" data-townforge-player-list>
        {{#if playerItems.length}}
        <div class="townforge-item-grid" role="list">
          {{#each playerItems}}
          <button type="button"
            class="townforge-item-cell rarity-{{rarityClass}}"
            role="listitem"
            {{#unless ../isGM}}draggable="true" data-action="toggleSell"{{/unless}}
            data-townforge-item-cell
            data-kind="player"
            data-item-id="{{id}}"
            data-name="{{name}}"
            data-type="{{type}}"
            data-price="{{sellPriceLabel}}"
            data-qty="{{quantity}}"
            data-rarity="{{rarityClass}}"
            data-img="{{img}}"
            aria-label="{{name}}, {{sellPriceLabel}}, qty {{quantity}}">
            <img src="{{img}}" alt="" />
            {{#if qtyBadge}}<span class="townforge-item-qty">{{qtyBadge}}</span>{{/if}}
          </button>
          {{/each}}
        </div>
        {{else}}
        <div class="townforge-empty"><p>{{#if isGM}}Players sell from their own inventory.{{else}}No sellable items.{{/if}}</p></div>
        {{/if}}
      </div>
    </section>

    <section class="townforge-trade-center">
      <h3>Trade Offer</h3>
      <div class="townforge-trade-offer-scroll">
        <div class="townforge-offer-block" data-townforge-offer-drop="buy">
          <div class="townforge-offer-heading">
            <h4>Buying</h4>
            <strong>{{buyTotalLabel}}</strong>
          </div>
          {{#if buyOffer.length}}
          <div class="townforge-item-grid townforge-offer-grid">
            {{#each buyOffer}}
            <div class="townforge-item-cell townforge-offer-cell rarity-{{rarityClass}}"
              data-townforge-item-cell
              data-kind="offer-buy"
              data-stock-id="{{stockId}}"
              data-name="{{name}}"
              data-type="{{type}}"
              data-price="{{linePriceLabel}}"
              data-qty="{{quantity}}"
              data-rarity="{{rarityClass}}"
              data-img="{{img}}">
              <img src="{{img}}" alt="" />
              <span class="townforge-item-qty">{{quantity}}</span>
              <div class="townforge-offer-cell-controls">
                <button type="button" data-action="adjustBuyQty" data-stock-id="{{stockId}}" data-delta="-1" {{#unless canDecrease}}disabled{{/unless}} aria-label="Decrease">−</button>
                <button type="button" data-action="adjustBuyQty" data-stock-id="{{stockId}}" data-delta="1" {{#unless canIncrease}}disabled{{/unless}} aria-label="Increase">+</button>
                <button type="button" class="townforge-offer-remove" data-action="removeBuy" data-stock-id="{{stockId}}" title="Remove" aria-label="Remove">×</button>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <p class="townforge-muted">{{#if isGM}}Hover a ware to inspect it.{{else}}Click or drag merchant wares here to buy.{{/if}}</p>
          {{/if}}
        </div>
        <div class="townforge-offer-block" data-townforge-offer-drop="sell">
          <div class="townforge-offer-heading">
            <h4>Selling</h4>
            <strong>{{sellTotalLabel}}</strong>
          </div>
          {{#if sellOffer.length}}
          <div class="townforge-item-grid townforge-offer-grid">
            {{#each sellOffer}}
            <div class="townforge-item-cell townforge-offer-cell rarity-{{rarityClass}}"
              data-townforge-item-cell
              data-kind="offer-sell"
              data-item-id="{{itemId}}"
              data-name="{{name}}"
              data-type="{{type}}"
              data-price="{{linePriceLabel}}"
              data-qty="{{quantity}}"
              data-rarity="{{rarityClass}}"
              data-img="{{img}}">
              <img src="{{img}}" alt="" />
              <span class="townforge-item-qty">{{quantity}}</span>
              <div class="townforge-offer-cell-controls">
                <button type="button" data-action="adjustSellQty" data-item-id="{{itemId}}" data-delta="-1" {{#unless canDecrease}}disabled{{/unless}} aria-label="Decrease">−</button>
                <button type="button" data-action="adjustSellQty" data-item-id="{{itemId}}" data-delta="1" {{#unless canIncrease}}disabled{{/unless}} aria-label="Increase">+</button>
                <button type="button" class="townforge-offer-remove" data-action="removeSell" data-item-id="{{itemId}}" title="Remove" aria-label="Remove">×</button>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <p class="townforge-muted">{{#if isGM}}Players sell from their own inventory.{{else}}Click or drag your items here to sell.{{/if}}</p>
          {{/if}}
        </div>
      </div>

      <footer class="townforge-trade-footer">
        <div class="townforge-trade-summary">
          <div class="townforge-trade-net{{#if netPositive}} is-pay{{/if}}{{#if netNegative}} is-gain{{/if}}">
            <span>{{netLabel}}</span>
            <strong>{{netAmountLabel}}</strong>
          </div>
        </div>

        {{#if tradeBlocked}}
        <p class="townforge-warn">{{tradeBlocked}}</p>
        {{/if}}

        {{#if isGM}}
        <p class="townforge-muted">GMs cannot barter on behalf of players.</p>
        {{else}}
        <button type="button" class="townforge-buy-btn townforge-buy-btn-lg" data-action="confirmTrade" {{#unless canConfirm}}disabled{{/unless}}>
          Barter
        </button>
        <button type="button" class="townforge-btn townforge-btn-secondary" data-action="clearOffer" {{#unless hasOffer}}disabled{{/unless}}>
          Clear Offer
        </button>
        {{/if}}
      </footer>
    </section>

    <section class="townforge-trade-pane">
      <header class="townforge-trade-pane-header">
        <div class="townforge-trade-pane-title">
          <h3>Merchant Wares</h3>
          <span class="townforge-pane-gold">{{itemCount}} items</span>
        </div>
        <label class="townforge-search">
          <span class="townforge-sr-only">Search shop</span>
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" value="{{query}}" placeholder="Search…" data-townforge-merchant-search autocomplete="off" />
        </label>
        <div class="townforge-merchant-filters">
          {{#each filters}}
          <button type="button" class="townforge-cat-tab{{#if active}} is-active{{/if}}" data-action="setFilter" data-filter="{{id}}">{{label}}</button>
          {{/each}}
        </div>
        <div class="townforge-merchant-filters townforge-price-filters" aria-label="Filter by price">
          {{#each priceFilters}}
          <button type="button" class="townforge-cat-tab{{#if active}} is-active{{/if}}" data-action="setPriceFilter" data-price-filter="{{id}}">{{label}}</button>
          {{/each}}
        </div>
        {{#if isGM}}
        <p class="townforge-hint townforge-merchant-drop-hint">Drag items here to add stock.</p>
        {{/if}}
      </header>
      <div class="townforge-trade-list"{{#if isGM}} data-townforge-merchant-drop{{/if}}>
        {{#if items.length}}
        <div class="townforge-item-grid" role="list">
          {{#each items}}
          <button type="button"
            class="townforge-item-cell rarity-{{rarityClass}}{{#if soldOut}} is-sold-out{{/if}}{{#if inOffer}} is-in-offer{{/if}}"
            role="listitem"
            {{#unless ../isGM}}draggable="true" data-action="toggleBuy"{{/unless}}
            data-townforge-item-cell
            data-kind="stock"
            data-stock-id="{{id}}"
            data-name="{{name}}"
            data-type="{{type}}"
            data-price="{{priceLabel}}"
            data-qty="{{quantityLabel}}"
            data-rarity="{{rarityClass}}"
            data-img="{{img}}"
            {{#if soldOut}}disabled{{/if}}
            aria-label="{{name}}, {{priceLabel}}, stock {{quantityLabel}}">
            <img src="{{img}}" alt="" />
            {{#if qtyBadge}}<span class="townforge-item-qty">{{qtyBadge}}</span>{{/if}}
            {{#if inOffer}}<span class="townforge-item-offered" aria-hidden="true"></span>{{/if}}
          </button>
          {{/each}}
        </div>
        {{else}}
        <div class="townforge-empty"><p>No matching wares.</p></div>
        {{/if}}
      </div>
    </section>
  </div>

  <aside class="townforge-item-tip" data-townforge-item-tip aria-hidden="true">
    <img data-tip-img alt="" />
    <div class="townforge-item-tip-copy">
      <h4 data-tip-name></h4>
      <p class="townforge-item-tip-meta" data-tip-meta></p>
      <p class="townforge-item-tip-price" data-tip-price></p>
      <ul class="townforge-item-props" data-tip-props></ul>
      <p class="townforge-item-tip-desc" data-tip-desc></p>
    </div>
  </aside>
</section>
