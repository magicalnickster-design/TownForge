<header class="townforge-header">
  <div class="townforge-brand">
    <h1>{{title}}</h1>
    <p class="townforge-subtitle">Browse pre-built NPCs and place them into your scene.</p>
  </div>

  {{#unless showingDetails}}
  <div class="townforge-toolbar">
    <label class="townforge-search">
      <span class="townforge-sr-only">Search NPCs</span>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="search"
        name="query"
        value="{{query}}"
        placeholder="Search by name, race, occupation…"
        data-townforge-search
        autocomplete="off"
      />
    </label>

    <div class="townforge-categories" role="toolbar" aria-label="NPC categories">
      {{#each categories}}
      <button
        type="button"
        class="townforge-category{{#if active}} is-active{{/if}}"
        data-action="setCategory"
        data-category="{{id}}"
      >
        {{label}}
      </button>
      {{/each}}
    </div>
  </div>
  {{/unless}}
</header>
