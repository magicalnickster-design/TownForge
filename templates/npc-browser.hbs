<div class="townforge-shell">
  <header class="townforge-topbar">
    <div class="townforge-brand">
      <span class="townforge-brand-mark" aria-hidden="true">
        <i class="fa-solid fa-chess-rook"></i>
      </span>
      <div class="townforge-brand-text">
        <span class="townforge-brand-title">{{title}}</span>
        <span class="townforge-brand-sub">NPC Library</span>
      </div>
    </div>
  </header>

  <div class="townforge-split">
    {{> "modules/townforge/templates/npc-content.hbs"}}
    {{> "modules/townforge/templates/npc-details.hbs"}}
  </div>

  <footer class="townforge-footer">
    <span class="townforge-footer-brand">Gambits Forge</span>
  </footer>
</div>
